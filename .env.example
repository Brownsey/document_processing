# Copy this file to `.env` and fill in the key for your chosen provider.
# Generation makes live API calls; only the selected provider's key is required.

# OpenAI (default provider)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna

# OpenRouter (select explicitly; OPENAI_MODEL does not apply)
OPENROUTER_API_KEY=
