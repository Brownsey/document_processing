# Copy this file to `.env` and fill in your own key. Generation makes live OpenAI calls.
# We give you a key to use for the exercise (ask if you don't have one).
OPENAI_API_KEY=sk-...

# Runtime model; Astra authors the separate prompt candidate for review.
OPENAI_MODEL=gpt-6-luna

# Optional adapter demonstration: select OpenRouter explicitly through the CLI.
# No OpenRouter calls are required for V1 validation.
# OPENROUTER_API_KEY=
